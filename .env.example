# Copy to .env and fill in your values.
# Docker Compose reads APP_PASSWORD / COOKIE_SECURE / PORT from here;
# `pnpm dev` also loads this file (APP_PASSWORD + REDIS_URL are used as fallbacks
# for NUXT_APP_PASSWORD / NUXT_REDIS_URL).
APP_PASSWORD=your-secret-password

# Local dev only — compose sets NUXT_REDIS_URL itself
# REDIS_URL=redis://localhost:6379

# Host port (optional)
# PORT=4000

# Set to false when accessing over plain HTTP (e.g. http://192.168.x.x:4000)
COOKIE_SECURE=false
